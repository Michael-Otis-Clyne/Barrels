n_rows   = n(),
n_NA     = sum(is.na(Fitness)),
n_over_1 = sum(Fitness > 1, na.rm = TRUE),
max_fit  = max(Fitness, na.rm = TRUE))
min_fit = min(Fitness, na.rm= T)
### checks
